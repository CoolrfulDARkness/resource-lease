{
  "name": "dsh-resource-lease",
  "version": "0.2.0",
  "private": true,
  "description": "Resource lease arbitration for agents sharing one machine: a Host service, three tools, runtime context and a tool guard, on lock files shared with the resource-lease CLI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/lock.js",
    "lib/resources.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "icon": "./icon.svg",
  "license": "MIT"
}
